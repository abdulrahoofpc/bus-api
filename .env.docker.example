# For docker-compose.yml. Copy to .env.docker and change before going live.
POSTGRES_PASSWORD=choose-a-strong-password
DJANGO_SECRET_KEY=paste-a-long-random-string-here
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.yourbusiness.in
CSRF_TRUSTED_ORIGINS=http://localhost:8080,https://api.yourbusiness.in
# Only needed if a browser (e.g. the app's web version) calls the API. Phones don't need it.
CORS_ALLOWED_ORIGINS=http://localhost:8081
APP_PORT=8080
# true = fill the database with the sample "Deccan Tours & Travels" data on first start
LOAD_DEMO_DATA=false
# set to true once the API is served over https
DJANGO_SECURE_COOKIES=false
