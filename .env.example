# Copy this file to ".env" (same folder as manage.py) for running on your own computer.
# Leave DATABASE_URL out to use a simple SQLite file (db.sqlite3) - easiest for trying it out.
# For real use, install PostgreSQL and use a line like:
# DATABASE_URL=postgres://fleet:fleet@localhost:5432/fleet
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Add your PC's Wi-Fi address (see "ipconfig") so phones can reach the API, e.g. 192.168.1.20
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata
# Only for browsers (the app's web version runs at http://localhost:8081). Phones don't need this.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
# Login attempts allowed per minute per address (more give HTTP 429)
# LOGIN_THROTTLE_RATE=10/min
# Interactive API docs at /api/docs/ (set false to hide them on a public server)
# API_DOCS=true
